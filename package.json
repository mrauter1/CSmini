{
  "name": "dustline-browser-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "qa:local-flow": "node scripts/qa/localFlowVerification.mjs",
    "qa:manual-signaling": "node scripts/qa/manualSignalingVerification.mjs",
    "qa:signaling-worker": "node scripts/qa/runWithLocalSignalingWorker.mjs scripts/qa/signalingWorkerProbe.mjs",
    "qa:cloud-signaling": "node scripts/qa/runWithLocalSignalingWorker.mjs scripts/qa/cloudSignalingVerification.mjs",
    "qa:cloud-signaling-14": "GUEST_COUNT=13 node scripts/qa/runWithLocalSignalingWorker.mjs scripts/qa/cloudSignalingVerification.mjs",
    "qa:turn-relay": "node scripts/qa/turnRelayProbe.mjs",
    "qa:host-room": "node scripts/qa/hostRoomStateVerification.mjs",
    "qa:shot-validation": "node scripts/qa/shotValidationVerification.mjs",
    "qa:final": "node scripts/qa/finalVerification.mjs",
    "test": "npm run build && node scripts/qa/finalVerification.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
